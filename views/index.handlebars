<div class="container py-5">
  <div class="p-5 mb-4 bg-body-tertiary rounded-3">
    <div class="container-fluid py-5">
      <h1 class="display-5 fw-bold">
        Bem-vindo ao BlogApp!
      </h1>
      <p class="col-md-8 fs-4">
        Projeto simples, desenvolvido com Node.js + Express + MongoDB.
      </p>
      <small>Leia sobre as principais novidades sobre diversos assuntos.</small><br
      />
      {{#if user}}{{else}}
        <p class="mt-3"><a
            href="/user/signUp"
            class="text-reset text-decoration-none"
          ><button class="btn btn-success">
            Crie a sua conta</a></button>
          ou
          <a href="/user/logIn" class="text-reset text-decoration-none"><button class="btn btn-success">
            acesse</button></a>
          caso já a tenhas.</p>
      {{/if}}
    </div>
  </div>
</div>
<h2 class="mt-3">Postagens recentes</h2>
{{#each post}}
  <div class="card">
    <div class="card-body">
      <small><strong>Categoria: </strong>{{category.name}}</small>
      <h3 class="mt-3">{{title}}</h3>
      <p class="mt-4">{{description}}</p>
      <small>Data de publicação: {{date}}</small><br />
      <a href="/post/{{slug}}"><button class="btn btn-success mt-2">Ler mais</button></a>
    </div>
  </div>
  <div class="mt-3"></div>
{{else}}
  <h5>Não há postagens registadas.</h5>
{{/each}}