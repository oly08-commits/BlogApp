<h2>{{category.name}}</h2>
{{#each post}}
  <div class="card">
    <div class="card-body">
      <h3 class="mt-3">{{title}}</h3>
      <p class="mt-4">{{description}}</p>
      <small>Data de publicação: {{date}}</small><br />
      <a href="/post/{{slug}}"><button class="btn btn-success mt-2">Ler mais</button></a>
    </div>
  </div>
{{else}}
  <h4 class="mt-5">Não há postagens nesta categoria.</h4>
{{/each}}
<a href="/admin/addPostOnCategory/{{category.slug}}"><button
    class="btn btn-success mt-2"
  >Adicionar</button></a>
<div class="mt-3"></div>